# Example rocket-mem.toml — every field the server understands, with its default value
# noted in a comment. Copy to rocket-mem.toml (auto-picked up from the current directory)
# or pass --config <path>, then uncomment and edit only what you need to change.
#
# Layering: built-in defaults < this file < ROCKET_MEM_* env vars < CLI flags.
# A field left unset here simply falls through to the next layer down, so there's no
# need to fully specify this file — set only what you want to change from the default.
# See docs/config-reference.md for the full reference this file mirrors.

# TCP address the RESP listener binds to. Any Redis client (redis-cli, redis-py,
# ioredis, go-redis, ...) connects here.
# addr = "127.0.0.1:6379"

# TCP address the RMP (rocket-mem's own binary protocol) listener binds to.
# Reachable only via the rmp-client crate, not redis-cli.
# rmp_addr = "127.0.0.1:6380"

# TCP address the Prometheus /metrics HTTP endpoint binds to. Loopback by default
# because it has no authentication of its own, ACL or not.
# metrics_addr = "127.0.0.1:9121"

# Path to the append-only file used for write-durability and crash recovery.
# aof_path = "./appendonly.aof"

# Path to the point-in-time snapshot file written by SAVE and loaded on startup.
# snapshot_path = "./dump.snapshot"

# Minimum command duration, in microseconds, that gets recorded to the slow log.
# 0 disables the slow log entirely.
# slowlog_threshold_micros = 10000

# --- Logging ------------------------------------------------------------------

# Tracing filter directive, e.g. "info", "debug", "trace", "rocket_mem=debug,warn" --
# same syntax as RUST_LOG. Overridden by the RUST_LOG environment variable when it is
# set; this field is only the default for a deployment that doesn't set RUST_LOG.
# log_level = "info"

# Maximum bytes of a value or command argument rendered into a `trace`-level log line
# before truncation. Only consulted when logging at `trace` -- lower it to keep trace
# logs readable, raise it to see whole values. Trace-level logging writes your data to
# disk in plaintext; see docs/config-reference.md's note on this before enabling it.
# log_value_max_bytes = 128

# --- Cluster mode -----------------------------------------------------------
# Both fields are unset by default (standalone mode). Setting one requires the other.

# Path to the cluster topology file: one "<node-id> <host:port> <first-slot> <last-slot>"
# line per node, covering all 16384 slots exactly once.
# cluster_config = "/etc/rocket-mem/cluster.conf"

# This node's id, matched against a line in cluster_config's topology file.
# cluster_node_id = "shard-a"

# How often, in seconds, the cluster peer prober probes every other node in the
# topology. Read only in cluster mode -- a standalone node has no peers and never
# starts a prober. Must be at least 1: a zero value crashes tokio's timer outright.
# Default: 1
# cluster_probe_interval_secs = 1

# How long, in seconds, a peer may go without answering a probe before this node
# reports it failed in CLUSTER NODES/SHARDS/INFO. Reporting only -- nothing is
# promoted, no topology is rewritten, and routing is unchanged. Must be at least 1:
# a zero value would report every peer failed the instant its last ack ages by a
# single second, a permanent false alarm spelled as a config typo.
# Default: 15
# cluster_node_timeout_secs = 15

# --- TLS ---------------------------------------------------------------------
# TLS listeners run *alongside* the plaintext ones — they never replace addr/rmp_addr.
# Setting either tls_resp_addr or tls_rmp_addr requires both tls_cert_path and
# tls_key_path to also be set; startup fails hard otherwise, before binding anything.
# Server-auth only — no mutual TLS, no client certificate is ever requested.

# TLS-wrapped RESP listener, run alongside the plaintext one at `addr`.
# tls_resp_addr = "0.0.0.0:16379"

# TLS-wrapped RMP listener, run alongside the plaintext one at `rmp_addr`.
# tls_rmp_addr = "0.0.0.0:16380"

# PEM certificate chain, shared by both TLS listeners. Resolved relative to the
# server's working directory, not to this file — prefer an absolute path.
# tls_cert_path = "/etc/rocket-mem/tls/server.crt"

# PEM private key, shared by both TLS listeners. Same relative-path caveat as above.
# tls_key_path = "/etc/rocket-mem/tls/server.key"

# The leader's certificate file, for THIS node's own replication connection (as a
# follower, via replicaof below) to verify and pin to when connecting over TLS. Unset
# means plaintext replication, regardless of whether tls_resp_addr/tls_rmp_addr above
# are set -- those govern this node's own listeners, not its outgoing connection to a
# leader.
# tls_ca_path = "/etc/rocket-mem/tls/leader-ca.crt"

# --- Replication & Failover Safety --------------------------------------------

# host:port of a leader to auto-connect to as a follower on every startup. Unset means
# standalone (or purely live-REPLICAOF-driven) operation -- REPLICAOF issued by hand
# still works with this field unset, it just isn't restored automatically on restart.
# Not validated at startup beyond being present: a bad host or unreachable leader is
# only discoverable by attempting the connection, so it fails soft with a background
# reconnect loop, exactly like the live REPLICAOF command's own behavior.
# replicaof = "127.0.0.1:6379"

# Username sent in AUTH before PSYNC, when replicaof's leader has ACL users configured.
# Must be set together with replicaof_auth_password, or neither -- rocket-mem checks
# this at startup, before any listener binds, and aborts if only one is set.
# replicaof_auth_username = "app"

# Password sent in AUTH before PSYNC. Plaintext in this file, same as [[acl.users]]'s
# own password field below -- there is no encryption-at-rest for config secrets.
# replicaof_auth_password = "change-me"

# The host:port THIS node advertises to its leader in PSYNC, and which the leader
# reports back in INFO REPLICATION's slaveN:ip=...,port=... lines. Left unset, this
# defaults to addr above -- the plaintext RESP listen address, even when replication
# itself runs over TLS. Set it when the address a peer must dial differs from the
# address this node binds: announce tls_resp_addr in a TLS deployment, or the
# externally reachable host:port under NAT or container port mapping. Shape-checked
# at startup (host:port, port must parse as u16) but never checked for reachability --
# this node cannot know how a peer routes to it.
# replica_announce_addr = "10.0.0.7:16379"

# Minimum number of replicas that must have acknowledged within min_replicas_max_lag_secs
# below for this leader node to accept write commands. 0 disables write fencing
# entirely, which is the default. A leader with fewer than this many recently-acking
# replicas refuses writes with a NOREPLICAS error instead of silently accepting writes
# no replica may ever receive -- see docs/config-reference.md's "Replica fencing" note.
# min_replicas_to_write = 0

# How many seconds old a replica's last acked offset may be and still count as "good"
# for min_replicas_to_write above. Ignored while min_replicas_to_write is 0. Setting
# min_replicas_to_write above 0 while leaving this at 0 is a startup error -- no
# replica could ever qualify and every write would be refused forever.
# min_replicas_max_lag_secs = 10

# --- ACL / authentication -----------------------------------------------------
# File-only: there is no flat ROCKET_MEM_* env var that can express an array of
# tables. Defining even one user here turns authentication ON for the whole server —
# there is no requirepass-style switch, and there is no recovery command short of
# restarting with an edited file if every user gets locked out.
#
# Bootstrap users here live only in memory at runtime: a user added later via the
# ACL SETUSER command is NOT persisted and is lost on restart unless it's also added
# to this array.
#
# Fields per entry:
#   username  string             required. Name passed to AUTH.
#   password  string, optional   default: unset (nopass — any password, or none, is
#                                 accepted). Plaintext here is argon2-hashed once at
#                                 startup and never written back out in plaintext —
#                                 not to the AOF, the snapshot, the slow log, or any
#                                 error message.
#   enabled   bool                default: true. false = loaded but AUTH rejects it.
#   rules     array of strings   default: [] (denies every command and key until
#                                 rules are added). Same token vocabulary as the
#                                 ACL SETUSER command: allcommands/nocommands, allkeys,
#                                 +CMD/-CMD, ~pattern. Applied left to right — a later
#                                 rule overrides an earlier one where they overlap.

# [[acl.users]]
# username = "admin"
# password = "change-me"
# enabled = true
# rules = ["allcommands", "allkeys"]

# [[acl.users]]
# username = "readonly"
# rules = ["~app:*", "+get"]
